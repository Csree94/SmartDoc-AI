# === SmartDoc AI environment configuration ===
# Copy this file to .env and fill in your real values. Never commit .env.

# Google Gemini API key (create at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Neon PostgreSQL connection string (create at https://neon.tech)
# Example: postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=your_neon_postgres_connection_string_here

# Optional: NVIDIA Nemotron fallback (configure later if time allows)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-nemotron-70b-instruct
